---
import Icon from '../Icon.astro';

// Staircase offsets are the Figma values (left 0/252/532, top 0/214/428 at 1440).
const steps = [
	{
		time: '30 m',
		badge: 'lg:w-[6.375rem]',
		grid: 'image20',
		title: 'Topic introduction',
		sub: '',
		body: 'Someone with hands-on experience — no vendor, no professional keynote speaker. The good, the bad and the ugly, ending with questions on the table.',
		pos: 'lg:left-0 lg:top-0',
	},
	{
		time: '3 x 30 m',
		badge: 'lg:w-[8.125rem]',
		imgs: ['image15', 'speakerPictureHd3', 'image12'],
		title: 'Trio breakouts',
		sub: '3 Rounds',
		body: 'One central question on screen. Three people is small enough to say the part you’d normally leave out. Every round a new group is created.',
		pos: 'lg:left-[15.75rem] lg:top-[13.375rem]',
	},
	{
		time: '30 m',
		badge: 'lg:w-[6.375rem]',
		grid: 'image20',
		title: 'Plenary wrap-up',
		sub: '',
		body: 'The host moderates the key insights and the next steps for everyone.',
		pos: 'lg:left-[33.25rem] lg:top-[26.75rem]',
	},
];
---

<section id="how-it-works" class="overflow-clip bg-cream py-section">
	<div class="container-large flex flex-col items-center justify-center gap-12">
		<div class="flex flex-col items-center justify-center text-center">
			<h2
				class="display max-w-[37.8125rem] text-[2.25rem] leading-none text-ink lg:text-h2"
				data-anim="text"
			>
				Here&rsquo;s how a session goes
			</h2>
		</div>

		<div
			class="flex w-full flex-col gap-8 lg:relative lg:block lg:h-[38.8125rem] lg:gap-0"
			data-flow-timeline
		>
			{
				steps.map((s) => (
					<div
						class:list={['flex flex-col items-start sm:flex-row lg:absolute', s.pos]}
						data-flow-step
					>
						<div class:list={['flex h-12 w-[6.375rem] shrink-0 items-center bg-sun', s.badge]}>
							<span class="flex h-12 w-12 items-center justify-center">
								<Icon name="hourglass" class="h-6 w-6 text-ink" tint />
							</span>
							<span class="whitespace-nowrap pr-3 font-mono text-base font-medium leading-[1.2] text-ink">
								{s.time}
							</span>
						</div>

						<div class="flex h-[12.0625rem] w-[18.0625rem] shrink-0">
							{s.grid ? (
								<img
									src={`/figma/${s.grid}.jpg`}
									alt=""
									loading="lazy"
									class="h-full w-full object-cover"
								/>
							) : (
								s.imgs!.map((i) => (
									<img
										src={`/figma/${i}.jpg`}
										alt=""
										loading="lazy"
										class="h-full w-1/3 object-cover"
									/>
								))
							)}
						</div>

						<div class="flex h-[12.0625rem] w-full max-w-[30.375rem] flex-col justify-center gap-6 bg-white p-4">
							<p class="font-display font-semibold tracking-[-0.03em] text-black">
								<span class="text-h4">{s.title}</span>
								{s.sub && <span class="text-h6 text-slate"> {s.sub}</span>}
							</p>
							<p class="text-xl font-medium leading-[1.2] text-black opacity-60">{s.body}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
