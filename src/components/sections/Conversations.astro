---
import Button from '../Button.astro';

const photos = ['image15', 'speakerPictureHd3', 'image12'];
---

<section class="overflow-clip bg-ink pt-section">
	<div class="container-large grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
		<!-- Breakout visual: three tiles with question overlay -->
		<div class="relative h-[35.625rem] w-full max-w-[41.375rem] shrink-0" data-anim="card">
			<div class="flex h-[35.625rem] gap-0">
				{
					photos.map((p) => (
						<img
							src={`/figma/${p}.jpg`}
							alt=""
							loading="lazy"
							class="h-full w-1/3 object-cover"
						/>
					))
				}
			</div>

			<div
				class="absolute left-1/2 top-[27.1875rem] z-10 -translate-x-[16.875rem] bg-blue p-[0.21875rem]"
			>
				<p class="font-mono text-[0.4375rem] font-medium leading-[1.2] tracking-[-0.03em] text-white">
					QUESTION&nbsp;&nbsp;1
				</p>
			</div>
			<div
				class="absolute left-1/2 top-[28.3125rem] w-[20.625rem] -translate-x-[8.125rem] bg-cream p-2"
			>
				<p class="display text-[0.99125rem] leading-[1.2] text-ink">
					What&rsquo;s the one default setting in your product you&rsquo;d change
					tomorrow to make insecure use harder? Who do you need to convince?
				</p>
			</div>
		</div>

		<!-- Copy -->
		<div class="flex flex-col gap-8">
			<h2 class="display max-w-[32.9375rem] text-[2.25rem] leading-[0.9] text-white/60 lg:text-h2" data-anim="text">
				<span class="line-through decoration-from-font">This isn&rsquo;t a lecture series,</span>
				<span class="text-white"> these are intense conversations and you&rsquo;re in them</span>
			</h2>

			<div class="flex flex-col gap-8">
				<p class="max-w-[30.5625rem] text-xl font-medium leading-[1.3] tracking-[-0.03em] text-white/80 lg:text-h5">
					Small breakouts, pointed questions, and a room built so people can say the
					part they&rsquo;d normally leave out. Nothing is recorded. Nobody is
					selling.
				</p>
				<div class="flex flex-wrap gap-8">
					<Button href="#how-it-works" variant="cream" label="Learn more about the sessions →" />
					<Button href="#apply" variant="ghost" label="Apply to join →" />
				</div>
			</div>
		</div>
	</div>
</section>
