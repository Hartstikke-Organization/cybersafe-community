---
import Icon from '../Icon.astro';

const logos = [
	{ src: 'image1', alt: 'Toreon', cls: 'h-[3.5625rem] w-[8.9375rem]' },
	{ src: 'image2', alt: 'eBO Enterprises', cls: 'h-[2.9375rem] w-[4.625rem]' },
	{ src: 'image3', alt: 'Colruyt Group', cls: 'h-[3.1875rem] w-[7rem]' },
	{ src: 'image4', alt: 'Zalando', cls: 'h-[1.375rem] w-[7.125rem]' },
];
---

<section class="overflow-clip bg-ink py-16">
	<div class="container-large flex flex-col items-center justify-between gap-10 lg:flex-row">
		<p class="display text-center text-xl text-cream lg:text-left lg:text-h5">
			A Conversation Starter community in partnership with Cybersafe
		</p>

		<div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
			<Icon name="vincotte" class="h-[3.8125rem] w-[3.875rem] shrink-0" />
			{
				logos.map((l) => (
					<img
						src={`/figma/${l.src}.png`}
						alt={l.alt}
						loading="lazy"
						class:list={['object-contain', l.cls]}
					/>
				))
			}
		</div>
	</div>
</section>
