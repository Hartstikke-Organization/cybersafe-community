---
import Icon from '../Icon.astro';
import Button from '../Button.astro';

const checks = [
	'Lead sales, marketing or product, or are CIO or CEO',
	'Work at a company building a physical product with software in it',
	'100–1,000 employees, majority Belgian-owned, product design in Belgium',
	'Are not a CISO or CTO',
];

const rows = [
	[
		{ id: 'first', label: 'First name', type: 'text', autocomplete: 'given-name' },
		{ id: 'last', label: 'Last name', type: 'text', autocomplete: 'family-name' },
	],
	[
		{ id: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
		{ id: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
	],
	[{ id: 'linkedin', label: 'LinkedIn URL', type: 'url', autocomplete: 'url' }],
	[
		{
			id: 'invite',
			label: 'Invitation (optional, who invited you?)',
			type: 'text',
			autocomplete: 'off',
		},
	],
];
---

<section id="apply" class="overflow-clip bg-cream py-section">
	<div class="container-large grid grid-cols-1 gap-16 lg:grid-cols-2">
		<!-- Left: profile + price -->
		<div class="flex flex-col justify-center gap-16">
			<div class="flex flex-col gap-8">
				<h2 class="display max-w-[31.875rem] text-[2.25rem] leading-[0.9] text-ink lg:text-h2" data-anim="text">
					Do you recognize yourself in this profile?
				</h2>

				<ul class="flex flex-col gap-2">
					{
						checks.map((c) => (
							<li class="flex items-start gap-2">
								<Icon name="check-fat" class="h-6 w-6 shrink-0" />
								<span class="max-w-[37.75rem] text-xl font-medium leading-[1.3] text-black">
									{c}
								</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="flex flex-col justify-center gap-6 bg-white p-8">
				<div class="flex flex-col gap-2">
					<span class="eyebrow text-ink opacity-60">What it costs</span>
					<p class="font-display text-h3 font-semibold tracking-[-0.03em] text-ink">
						&euro;200
					</p>
				</div>
				<p class="max-w-[30rem] text-base font-semibold leading-[1.4] text-black opacity-60">
					Covers the costs of the six online sessions and the dinner at the castle.
					That&rsquo;s all it is — not a product, not a subscription.
				</p>
			</div>
		</div>

		<!-- Right: application form -->
		<form class="flex flex-col gap-6 bg-blue p-8">
			<p class="max-w-[30.125rem] text-xl font-medium leading-[1.3] tracking-[-0.03em] text-cream lg:text-h5">
				Places are limited and applications are read by a person — you&rsquo;ll hear
				back either way.
			</p>

			{
				rows.map((row) => (
					<div class="flex flex-col gap-6 sm:flex-row">
						{row.map((f) => (
							<div class="flex flex-1 flex-col gap-2">
								<label for={f.id} class="font-display text-base leading-[1.5] text-cream">
									{f.label}
								</label>
								<input
									id={f.id}
									name={f.id}
									type={f.type}
									autocomplete={f.autocomplete}
									class="h-12 w-full border-b border-cream/30 bg-transparent p-3 text-cream outline-none transition-colors focus:border-cream"
								/>
							</div>
						))}
					</div>
				))
			}

			<label class="flex items-center gap-2 text-base text-cream">
				<input
					type="checkbox"
					name="terms"
					required
					class="h-4 w-4 shrink-0 accent-white"
				/>
				<span class="underline underline-offset-2">I accept the Terms</span>
			</label>

			<Button type="submit" variant="cream" class="w-fit" label="Apply to join →" />
		</form>
	</div>
</section>
