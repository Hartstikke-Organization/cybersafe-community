---
import Icon from '../Icon.astro';

const checks = [
	'Lead sales, marketing or product, or are CIO or CEO',
	'Work at a company building a physical product with software in it',
	'100–1,000 employees, majority Belgian-owned, product design in Belgium',
	'Are not a CISO or CTO',
];

const fields = [
	{ id: 'first', label: 'First name', type: 'text', full: false, autocomplete: 'given-name' },
	{ id: 'last', label: 'Last name', type: 'text', full: false, autocomplete: 'family-name' },
	{ id: 'email', label: 'Email', type: 'email', full: false, autocomplete: 'email' },
	{ id: 'phone', label: 'Phone number', type: 'tel', full: false, autocomplete: 'tel' },
	{ id: 'linkedin', label: 'LinkedIn URL', type: 'url', full: true, autocomplete: 'url' },
	{ id: 'invite', label: 'Invitation (optional, who invited you?)', type: 'text', full: true, autocomplete: 'off' },
];
---

<section id="apply" class="bg-cream text-ink">
	<div class="wrap grid gap-10 py-20 lg:grid-cols-2 lg:gap-16 lg:py-section">
		<!-- Left: profile + price -->
		<div class="flex flex-col gap-8">
			<h2
				class="font-display text-4xl font-medium leading-[1.05] tracking-tight lg:text-5xl"
			>
				Do you recognize yourself in this profile?
			</h2>

			<ul class="flex flex-col gap-4">
				{
					checks.map((c) => (
						<li class="flex items-start gap-3">
							<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded bg-blue text-cream">
								<Icon name="check" class="h-3.5 w-3.5" stroke={2.6} />
							</span>
							<span class="text-base text-ink/90">{c}</span>
						</li>
					))
				}
			</ul>

			<div class="rounded-2xl border border-ink/10 p-6">
				<span class="eyebrow text-slate">What it costs</span>
				<p class="mt-2 font-display text-5xl font-medium tracking-tight">&euro;200</p>
				<p class="mt-3 max-w-sm text-sm leading-relaxed text-slate">
					Covers the costs of the six online sessions and the dinner at the castle.
					That&rsquo;s all it is — not a product, not a subscription.
				</p>
			</div>
		</div>

		<!-- Right: application form -->
		<div class="rounded-2xl bg-blue p-6 text-cream sm:p-8">
			<p class="text-lg leading-snug text-cream">
				Places are limited and applications are read by a person — you&rsquo;ll hear
				back either way.
			</p>

			<form class="mt-8 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
				{
					fields.map((f) => (
						<div class:list={[f.full && 'sm:col-span-2']}>
							<label for={f.id} class="block text-sm text-cream/60">
								{f.label}
							</label>
							<input
								id={f.id}
								name={f.id}
								type={f.type}
								autocomplete={f.autocomplete}
								class="mt-1 w-full border-b border-cream/30 bg-transparent py-2 text-cream outline-none transition-colors placeholder:text-cream/40 focus:border-cream"
							/>
						</div>
					))
				}

				<label class="flex items-center gap-2 text-sm text-cream/80 sm:col-span-2">
					<input
						type="checkbox"
						name="terms"
						required
						class="h-4 w-4 rounded border-cream/40 accent-cream"
					/>
					I accept the <a href="#" class="underline underline-offset-2">Terms</a>
				</label>

				<button type="submit" class="btn btn-cream w-fit text-sm sm:col-span-2">
					Apply to join
					<Icon name="arrow-right" class="h-4 w-4" stroke={2} />
				</button>
			</form>
		</div>
	</div>
</section>
