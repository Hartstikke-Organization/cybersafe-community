---
import Icon from '../Icon.astro';

// Radial Cards Slider (see OSMO.md)
// Real early members; each card links to their LinkedIn.
const people = [
	{
		img: '/self-imported/people/maximbaele.jpg',
		name: 'Maxim Baele',
		role: 'Product Security Consultant, Toreon',
		linkedin: 'https://www.linkedin.com/in/maximbaele/',
	},
	{
		img: '/self-imported/people/stevenwierckx.jpg',
		name: 'Steven Wierckx',
		role: 'Principal Consultant, Toreon',
		linkedin: 'https://www.linkedin.com/in/steven-wierckx/',
	},
	{
		img: '/self-imported/people/williamvisterin.jpg',
		name: 'William Visterin',
		role: 'IT & business journalist',
		linkedin: 'https://www.linkedin.com/in/visterin/',
	},
];
---

<section class="overflow-clip bg-cream py-section">
	<div class="container-large flex flex-col items-center gap-16">
		<h2
			class="display max-w-[53.25rem] text-center text-[2.25rem] leading-[0.9] text-ink lg:text-h2"
			data-anim="text"
		>
			Mixed roles, diverse connections<br />
			These are the people you&rsquo;ll get to know
		</h2>

		<div
			data-radial-slider-drag-status="grab"
			data-radial-slider-init
			class="radial-gsap-slider"
		>
			<div data-radial-slider-collection class="radial-gsap-slider__collection">
				<div data-radial-slider-list class="radial-gsap-slider__list">
					{
						people.map((p, i) => (
							<div
								data-radial-slider-item-status={i === 0 ? 'active' : 'inview'}
								data-radial-slider-item
								class="radial-gsap-slider__item"
							>
								<a
									href={p.linkedin}
									target="_blank"
									rel="noopener"
									class="person-card"
								>
									<div class="person-card__media">
										<img
											src={encodeURI(p.img)}
											loading="lazy"
											alt={p.name}
											draggable="false"
											class="cover-image"
										/>
									</div>
									<div class="person-card__info">
										<h3 class="person-card__h">{p.name}</h3>
										<p class="person-card__role">{p.role}</p>
									</div>
								</a>
							</div>
						))
					}
				</div>
			</div>
			<div class="radial-gsap-slider__controls">
				<button
					data-radial-slider-control="prev"
					class="radial-gsap-slider__control-btn"
					aria-label="Previous person"
				>
					<Icon name="arrow-left" class="h-6 w-6" />
				</button>
				<button
					data-radial-slider-control="next"
					class="radial-gsap-slider__control-btn is--next"
					aria-label="Next person"
				>
					<Icon name="arrow-right" class="h-6 w-6" />
				</button>
			</div>
		</div>
	</div>
</section>
