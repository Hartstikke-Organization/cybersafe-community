---
// Flick Cards Slider (see OSMO.md) — needs a minimum of 7 cards for drag.
const people = [
	{ img: 'speakerPictureHd3', name: 'Jane Doe', role: 'Commercial Director, Zalando' },
	{ img: 'image11', name: 'Amara Okoye', role: 'Head of Product, Niko' },
	{ img: 'hillaryUngsonCommunityPicture4', name: 'Lotte Maes', role: 'CMO, Barco' },
	{ img: 'image12', name: 'Rohan Desai', role: 'CIO, Televic' },
	{ img: 'speakerPictureHd5', name: 'Yves Mertens', role: 'CEO, Qbic' },
	{ img: 'hillaryUngsonCommunityPicture3', name: 'Karim Haddad', role: 'VP Sales, Sirris' },
	{ img: 'image14', name: 'Daniel Owusu', role: 'Product Lead, Sensolus' },
	{ img: 'hillaryUngsonCommunityPicture5', name: 'Tom Claes', role: 'CEO, Xenics' },
	{ img: 'image15', name: 'Sofie Peeters', role: 'Marketing Director, Ontex' },
];
---

<section class="overflow-clip bg-cream py-section">
	<div class="container-large flex flex-col items-center gap-16">
		<h2
			class="display max-w-[53.25rem] text-center text-[2.25rem] leading-[0.9] text-ink lg:text-h2"
			data-anim="text"
		>
			Mixed roles, diverse connections<br />
			These are the people you&rsquo;ll get to know
		</h2>

		<div data-flick-cards-init class="flick-group">
			<div class="flick-group__relative-object">
				<div class="flick-group__relative-object-before"></div>
			</div>
			<div data-flick-cards-collection class="flick-group__collection">
				<div data-flick-cards-list class="flick-group__list">
					{
						people.map((p) => (
							<div data-flick-cards-item-status data-flick-cards-item class="flick-group__item">
								<div class="flick-card">
									<div class="flick-card__before" />
									<div class="flick-card__media">
										<img
											width="256"
											loading="lazy"
											alt={p.name}
											src={`/figma/${p.img}.jpg`}
											class="cover-image"
										/>
										<a href="#apply" class="flick-card__btn">
											<span class="flick-card__btn-span">{p.role}</span>
										</a>
										<h3 class="flick-card__h3">{p.name}</h3>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
