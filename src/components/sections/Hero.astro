---
import Icon from '../Icon.astro';

// Three columns, each cycling the same trio of tiles (Figma: Group 6 / 7 / 8)
const columns = [
	['speakerPictureHd3', 'image11', 'hillaryUngsonCommunityPicture3'],
	['hillaryUngsonCommunityPicture4', 'image12', 'speakerPictureHd5'],
	['hillaryUngsonCommunityPicture5', 'image14', 'image15'],
];

const pills = [
	{ icon: 'chats', label: '6 Sessions' },
	{ icon: 'calendar', label: 'November to April' },
	{ icon: 'plugs', label: 'Diverse connections' },
];
---

<!-- Desktop hero is exactly one viewport tall; min-height keeps the content from
     being clipped on unusually short windows (the section is overflow-clip). -->
<section id="top" class="relative overflow-clip bg-ink py-4 lg:h-screen lg:min-h-[640px]">
	<div class="container-large relative h-full">
		<!-- Video-call gallery — 3 columns, right-aligned, bleeding top and bottom -->
		<div
			class="pointer-events-none absolute inset-y-0 right-4 hidden w-[35.8125rem] lg:flex"
			aria-hidden="true"
		>
			{
				columns.map((tiles, i) => (
					<div class="relative w-[11.9375rem] overflow-clip">
						<div class={`absolute inset-x-0 top-[-23.1875rem] hero-col hero-col-${i + 1}`}>
							{[0, 1, 2, 3, 4].map(() =>
								tiles.map((t) => (
									<img
										src={`/figma/${t}.jpg`}
										alt=""
										loading="eager"
										class="block h-[11.9375rem] w-[11.9375rem] object-cover"
									/>
								))
							)}
						</div>
					</div>
				))
			}
		</div>

		<!-- Mobile gallery -->
		<div class="mt-24 grid grid-cols-3 gap-0 lg:hidden" aria-hidden="true">
			{
				columns
					.flatMap((c) => c.slice(0, 2))
					.map((t) => (
						<img
							src={`/figma/${t}.jpg`}
							alt=""
							loading="lazy"
							class="aspect-square w-full object-cover"
						/>
					))
			}
		</div>

		<div class="relative flex flex-col justify-center gap-20 py-16 lg:h-full lg:py-0">
			<div class="flex max-w-[51.875rem] flex-col gap-6">
				<h1 class="display max-w-[47.6875rem] text-[3rem] leading-[0.9] text-cream sm:text-[4.5rem] lg:text-display">
					What could security win you?
				</h1>
				<p class="font-display text-2xl leading-[1.5] text-cream lg:text-h4">
					6 peer sessions &hellip;
				</p>
				<p class="max-w-[33.4375rem] text-lg font-medium leading-[1.5] text-cream/60 lg:text-xl">
					All settled facts — and pioneers are already turning them into an advantage.
					Belgium runs ahead of the European schedule, which is a head start if you play
					it.
				</p>
			</div>

			<div class="flex flex-col gap-4 lg:absolute lg:bottom-0 lg:left-0">
				<p class="font-display text-base font-medium leading-[1.5] text-cream">
					Learning Network combining peers and experts
				</p>
				<div class="flex max-w-[47.6875rem] flex-wrap gap-4">
					{
						pills.map((p) => (
							<a href="#sessions" class="pill">
								<Icon name={p.icon} class="h-6 w-6" />
								{p.label}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-col {
		animation-duration: 3.99239s;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
	}
	.hero-col-1 {
		animation-name: hero-shift-down;
	}
	.hero-col-2 {
		animation-name: hero-shift-up;
	}
	.hero-col-3 {
		animation-name: hero-shift-short;
	}

	@keyframes hero-shift-down {
		0% {
			animation-timing-function: cubic-bezier(0.874, 0, 0.14, 1);
			translate: 0 23.875rem;
		}
		37.533% {
			translate: 0 0;
		}
		62.694% {
			animation-timing-function: cubic-bezier(0.89, 0, 0.12, 1);
			translate: 0 0;
		}
		100% {
			translate: 0 23.875rem;
		}
	}
	@keyframes hero-shift-up {
		0% {
			animation-timing-function: cubic-bezier(0.874, 0, 0.14, 1);
			translate: 0 -23.875rem;
		}
		37.533% {
			translate: 0 0;
		}
		62.694% {
			animation-timing-function: cubic-bezier(0.891, 0, 0.121, 1);
			translate: 0 0;
		}
		100% {
			translate: 0 -23.875rem;
		}
	}
	@keyframes hero-shift-short {
		0% {
			animation-timing-function: cubic-bezier(0.874, 0, 0.14, 1);
			translate: 0 11.9375rem;
		}
		37.532% {
			translate: 0 0;
		}
		62.701% {
			animation-timing-function: cubic-bezier(0.89, 0, 0.12, 1);
			translate: 0 0;
		}
		100% {
			translate: 0 11.9375rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-col {
			animation: none;
		}
	}
</style>
