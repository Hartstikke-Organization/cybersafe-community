---
import Icon from '../Icon.astro';

// 12 participants split across 3 columns (see `columns` below).
const avatarDir = '/self-imported/hero-avatars';
const avatars = [
	'image 7.webp',
	'image 7-1.webp',
	'image 7-2.webp',
	'image 7-3.webp',
	'image 8.webp',
	'image 9.webp',
	'Hillary Ungson Community Picture 1.webp',
	'Hillary Ungson Community Picture 1-1.webp',
	'Hillary Ungson Community Picture 1-2.webp',
	'Hillary Ungson Community Picture 2.webp',
	'Speaker Picture HD 2.webp',
	'Speaker Picture HD 2-1.webp',
];

// 3 columns of 4. Each column strip is repeated COPIES times so it can shift by
// one tile and loop seamlessly (extra copies sit off-screen, above and below).
// Keep COPIES in sync with initBreakout in animations.js.
const columns = [avatars.slice(0, 4), avatars.slice(4, 8), avatars.slice(8, 12)];
const COPIES = 4;

const pills = [
	{ icon: 'chats', label: '6 online sessions' },
	{ icon: 'calendar', label: 'November to April' },
	{ icon: 'plugs', label: 'Diverse connections' },
];
---

<!-- Desktop hero is exactly one viewport tall; min-height keeps the content from
     being clipped on unusually short windows (the section is overflow-clip). -->
<section id="top" class="relative overflow-clip bg-ink py-4 lg:h-screen lg:min-h-[640px]">
	<div class="container-large relative h-full">
		<!-- Breakout-room gallery — three columns of participants that gently shift
		     by one tile, with a question card between each move. -->
		<div
			class="pointer-events-none absolute inset-y-0 right-4 hidden w-[35.8125rem] lg:block"
			aria-hidden="true"
		>
			<div class="breakout" data-breakout>
				<div class="breakout__grid">
					{
						columns.map((col) => (
							<div class="breakout__col-clip">
								<div class="breakout__col" data-col>
									{Array.from({ length: COPIES }).map(() =>
										col.map((a) => (
											<div class="breakout__tile">
												<img
													src={`${avatarDir}/${encodeURIComponent(a)}`}
													alt=""
													loading="eager"
													class="breakout__img"
												/>
											</div>
										))
									)}
								</div>
							</div>
						))
					}
				</div>

				<div class="breakout__scrim" data-breakout-scrim></div>

				<div class="breakout__q" data-breakout-q>
					<span class="breakout__q-label" data-q-label>Question 1</span>
					<div class="breakout__q-card"><p data-q-text></p></div>
				</div>
			</div>
		</div>

		<!-- Mobile gallery (static) -->
		<div class="mt-24 grid grid-cols-3 gap-0 lg:hidden" aria-hidden="true">
			{
				avatars
					.slice(0, 6)
					.map((a) => (
						<img
							src={`${avatarDir}/${encodeURIComponent(a)}`}
							alt=""
							loading="lazy"
							class="aspect-square w-full object-cover"
						/>
					))
			}
		</div>

		<div class="relative flex flex-col justify-center gap-20 py-16 lg:h-full lg:py-0">
			<div class="flex max-w-[51.875rem] flex-col gap-6">
				<h1 class="display max-w-[47.6875rem] text-[3rem] leading-[0.9] text-cream sm:text-[4.5rem] lg:text-display">
					What could security win you?
				</h1>
				<p class="font-display text-2xl leading-[1.5] text-cream lg:text-h4">
					6 sessions. 20 Belgian leaders. Peers and experts.
				</p>
				<p class="max-w-[33.4375rem] text-lg font-medium leading-[1.5] text-cream/60 lg:text-xl">
					CyberSafe Community is a learning network combining peers and experts, for
					leaders in sales, marketing, product and management who want to turn that into
					more sales, better products and a stronger reputation.
				</p>

				<a
					href="https://www.toreon.com/"
					target="_blank"
					rel="noopener"
					class="pill w-fit"
				>
					Driven by
					<img src="/figma/image1.png" alt="Toreon" class="h-6 w-auto" />
				</a>
			</div>

			<div class="flex flex-col gap-4 lg:absolute lg:bottom-0 lg:left-0">
				{
					pills.map((p) => (
						<div class="flex items-center gap-3 font-display text-base font-medium leading-[1.5] text-cream">
							<Icon name={p.icon} class="h-6 w-6 shrink-0" />
							{p.label}
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.breakout {
		position: absolute;
		inset: 0;
	}
	/* Fills the hero's right column, bleeding top and bottom. */
	.breakout__grid {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}
	/* Each column: a clip window with a taller strip translated inside it. */
	.breakout__col-clip {
		position: relative;
		overflow: hidden;
	}
	.breakout__col {
		position: absolute;
		inset-inline: 0;
		top: 0;
		will-change: transform;
	}
	.breakout__tile {
		position: relative;
		aspect-ratio: 1;
		overflow: hidden;
	}
	.breakout__img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}
	.breakout__scrim {
		position: absolute;
		inset: 0;
		background: rgba(16, 16, 16, 0.55);
		opacity: 0;
		z-index: 1;
	}
	.breakout__q {
		position: absolute;
		left: 1.25rem;
		top: 46%;
		z-index: 2;
		width: 21rem;
		max-width: 82%;
	}
	.breakout__q-label {
		display: inline-block;
		background: var(--color-blue, #273c8b);
		color: #fff;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.5625rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.2rem 0.45rem;
		line-height: 1;
	}
	.breakout__q-card {
		background: #101010;
		color: #f7f5f0;
		padding: 0.9rem 1.1rem;
		font-size: 0.95rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
		box-shadow: 0 12px 34px rgba(0, 0, 0, 0.4);
	}
</style>
