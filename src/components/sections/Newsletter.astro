---
import Button from '../Button.astro';
---

<section class="overflow-clip bg-cream py-section">
	<div class="container-large flex flex-col items-center justify-center gap-16">
		<div class="flex flex-col items-center justify-center gap-6 text-center">
			<h2 class="display max-w-[31.875rem] text-[2.25rem] leading-[0.9] text-ink lg:text-h2" data-anim="text">
				Outside the profile, or can&rsquo;t make the dates?
			</h2>
			<p class="max-w-[37.75rem] text-xl font-medium leading-[1.3] tracking-[-0.03em] text-ink lg:text-h5">
				Couldn&rsquo;t make it or didn&rsquo;t meet the requirements? Don&rsquo;t
				worry, we create summaries of our insights for each session. Sign up below
			</p>
		</div>

		<form class="flex w-full max-w-[41.25rem] items-center justify-center gap-6 bg-white p-4">
			<div class="flex flex-1 flex-col">
				<label for="newsletter-email" class="sr-only">Email address</label>
				<input
					id="newsletter-email"
					name="email"
					type="email"
					placeholder="Fill in your e-mail address"
					autocomplete="email"
					class="h-12 w-full border-b border-ink/20 bg-transparent p-3 font-display text-base text-ink outline-none transition-colors placeholder:text-ink focus:border-ink"
				/>
			</div>
			<Button type="submit" variant="blue" class="shrink-0" label="Apply to join →" />
		</form>
	</div>
</section>
