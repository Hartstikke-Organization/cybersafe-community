---
---

<section class="bg-cream pb-4 pt-section">
	<div class="container-large">
		<!-- Inner frame sits inside the container padding, so the image keeps the
		     1rem gutter instead of bleeding to the container's edge. -->
		<div
			class="relative flex min-h-[37.5rem] origin-center flex-col items-center justify-end overflow-clip p-12 lg:h-[48.125rem]"
			data-quote-frame
		>
			<img
				src="/figma/container.jpg"
				alt=""
				loading="lazy"
				class="absolute inset-0 h-full w-full object-cover"
			/>
			<div class="absolute inset-0 bg-black/20"></div>

			<blockquote class="relative flex w-full max-w-[77.5rem] justify-center">
				<p class="display text-center text-[2rem] leading-[0.9] text-white sm:text-[3rem] lg:text-h1">
					&ldquo;A consultant tells you what the law says; a peer tells you what they
					actually did, what it cost, and where they went too far.&rdquo;
				</p>
			</blockquote>
		</div>
	</div>
</section>
