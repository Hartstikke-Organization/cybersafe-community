---
const links = [
	{ label: 'For who', href: '#for-who' },
	{ label: 'The sessions', href: '#sessions' },
	{ label: 'How it works', href: '#how-it-works' },
	{ label: 'Apply to join', href: '#apply' },
];
---

<footer class="overflow-clip bg-cream pb-4 pt-section">
	<div class="container-large flex flex-col items-center justify-center gap-16">
		<nav class="flex flex-wrap items-center justify-center gap-4">
			{
				links.map((l) => (
					<a
						href={l.href}
						class="px-2 py-1 font-display text-base font-medium leading-[1.5] text-ink transition-opacity hover:opacity-60"
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="flex w-full flex-col items-center gap-6">
			<img
				src="/self-imported/Header/7/footer-logo.svg"
				alt="CyberSafe Community"
				width="1400"
				height="108"
				class="h-auto w-full"
			/>
			<p class="text-center font-display text-sm leading-[1.5] text-ink/60">
				Powered by
				<a
					href="http://conversationstarter.net"
					target="_blank"
					rel="noopener"
					class="text-ink underline underline-offset-2 transition-opacity hover:opacity-70"
					>Conversation Starter</a
				> ×
				<a
					href="https://www.cybersafe-madeinbelgium.be/#3444eccb1c9f809a9119d4d902d09d31"
					target="_blank"
					rel="noopener"
					class="text-ink underline underline-offset-2 transition-opacity hover:opacity-70"
					>CyberSafe</a
				> – Made In Belgium
			</p>
		</div>
	</div>
</footer>
