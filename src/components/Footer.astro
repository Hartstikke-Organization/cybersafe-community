---
import Icon from '../components/Icon.astro';

const links = [
	{ label: 'For who', href: '#for-who' },
	{ label: 'The sessions', href: '#sessions' },
	{ label: 'How it works', href: '#how-it-works' },
	{ label: 'Apply to join', href: '#apply' },
];
---

<footer class="overflow-clip bg-cream pb-4 pt-section">
	<div class="container-large flex flex-col items-center justify-center gap-16">
		<nav class="flex flex-wrap items-center justify-center gap-4">
			{
				links.map((l) => (
					<a
						href={l.href}
						class="px-2 py-1 font-display text-base font-medium leading-[1.5] text-ink transition-opacity hover:opacity-60"
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="flex w-full items-start justify-between gap-4">
			<span
				class="display whitespace-nowrap text-[13vw] leading-[0.9] text-ink/[0.09] lg:text-[8rem]"
			>
				CyberSafe Community
			</span>
			<Icon name="globe" class="hidden h-16 w-16 shrink-0 text-ink sm:block" tint />
		</div>
	</div>
</footer>
