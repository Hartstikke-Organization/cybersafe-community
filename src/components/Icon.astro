---
/* Lightweight inline icon set (Phosphor-inspired), colored via currentColor. */
interface Props {
	name: string;
	class?: string;
	stroke?: number;
}
const { name, class: cls = 'h-6 w-6', stroke = 1.6 } = Astro.props;

const paths: Record<string, string> = {
	'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
	check: '<path d="M20 6 9 17l-5-5"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
	close: '<path d="M6 6l12 12M18 6 6 18"/>',
	calendar:
		'<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M16 2.5v4M8 2.5v4M3 9.5h18"/>',
	chats:
		'<path d="M21 14a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/>',
	globe:
		'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.4 4 5.6 4 9s-1.4 6.6-4 9c-2.6-2.4-4-5.6-4-9s1.4-6.6 4-9z"/>',
	cpu:
		'<rect x="6" y="6" width="12" height="12" rx="1.5"/><rect x="9.5" y="9.5" width="5" height="5" rx="0.5"/><path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3"/>',
	users:
		'<circle cx="8.5" cy="8" r="3"/><path d="M2.5 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 20a5.5 5.5 0 0 1 6-4.9"/>',
	pin: '<path d="M12 21s7-6.6 7-12a7 7 0 1 0-14 0c0 5.4 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/>',
	plugs:
		'<path d="M9 15l6-6M8.5 12.5l-2 2a3 3 0 1 0 4.2 4.2l2-2M15.5 11.5l2-2a3 3 0 1 0-4.2-4.2l-2 2"/>',
	hourglass:
		'<path d="M6 3h12M6 21h12M7.5 3c0 4 4.5 6 4.5 9s-4.5 5-4.5 9M16.5 3c0 4-4.5 6-4.5 9s4.5 5 4.5 9"/>',
	play: '<path d="M8 5.5v13l10-6.5z"/>',
};
const d = paths[name] ?? '';
---
<svg
	class={cls}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={stroke}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={d}
></svg>
