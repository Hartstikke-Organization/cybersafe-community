---
/* Inlines the Figma-exported Phosphor SVGs from src/icons.
   `tint` swaps the exported fill for currentColor so the icon can inherit text color. */
interface Props {
	name: string;
	class?: string;
	tint?: boolean;
}
const { name, class: cls = 'h-6 w-6', tint = false } = Astro.props;

const files = import.meta.glob<string>('../icons/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

const raw = files[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" not found in src/icons/`);

let svg = raw
	.replace(/<\?xml[^>]*\?>/, '')
	.replace(/\swidth="[^"]*"/, '')
	.replace(/\sheight="[^"]*"/, '')
	.replace(/\sstyle="[^"]*"/, '');

if (tint) svg = svg.replace(/fill="(?!none)[^"]*"/g, 'fill="currentColor"');

svg = svg.replace('<svg', `<svg class="${cls}" aria-hidden="true" focusable="false"`);
---

<Fragment set:html={svg} />
