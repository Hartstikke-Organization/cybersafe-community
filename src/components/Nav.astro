---
import Icon from './Icon.astro';

const links = [
	{ label: 'For who', href: '#for-who' },
	{ label: 'The sessions', href: '#sessions' },
	{ label: 'How it works', href: '#how-it-works' },
];
---

<nav class="wrap flex items-center justify-between py-6 text-cream">
	<!-- Logo mark -->
	<a href="#top" class="flex items-center gap-2" aria-label="CyberSafe Community — home">
		<Icon name="globe" class="h-6 w-6" />
		<span class="text-white/40" aria-hidden="true">&times;</span>
		<Icon name="chats" class="h-6 w-6" />
		<span class="sr-only">CyberSafe Community</span>
	</a>

	<!-- Center menu -->
	<div class="hidden items-center gap-1 md:flex">
		{
			links.map((l) => (
				<a
					href={l.href}
					class="rounded-full px-4 py-2 text-base text-cream/90 transition-colors hover:bg-white/10 hover:text-cream"
				>
					{l.label}
				</a>
			))
		}
	</div>

	<!-- CTA -->
	<a href="#apply" class="btn btn-cream text-sm">
		Apply to join
		<Icon name="arrow-right" class="h-4 w-4" stroke={2} />
	</a>
</nav>
