---
import Icon from './Icon.astro';
import Button from './Button.astro';

const links = [
	{ label: 'For who', href: '#for-who' },
	{ label: 'The sessions', href: '#sessions' },
	{ label: 'How it works', href: '#how-it-works' },
];
---

<header class="site-nav fixed inset-x-0 top-0 z-50" data-nav data-nav-theme="dark">
	<div class="container-large relative flex items-center justify-between py-8">
		<a href="#top" class="site-nav__logo flex items-center" aria-label="CyberSafe Community — home">
			<img
				src="/self-imported/nav-logo-mobile.svg"
				alt=""
				width="61"
				height="25"
				class="h-6 w-auto md:hidden"
			/>
			<img
				src="/self-imported/nav-logo-desktop.png"
				alt=""
				width="398"
				height="49"
				class="hidden h-6 w-auto md:block"
			/>
			<span class="sr-only">CyberSafe Community</span>
		</a>

		<!-- Absolutely centred so the logo and CTA widths never shift it. -->
		<div
			class="site-nav__links absolute left-1/2 hidden -translate-x-1/2 items-center gap-2 md:flex"
		>
			{
				links.map((l) => (
					<a href={l.href} class="site-nav__link px-3 py-2 font-display text-base font-medium">
						{l.label}
					</a>
				))
			}
		</div>

		<Button href="#apply" variant="cream" class="site-nav__cta" label="Apply to join →" />
	</div>
</header>
